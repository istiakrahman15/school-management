# ============================================================
# SmartSchool OS - Environment Variables Example
# Copy this file to .env.local and fill in your values
# ============================================================

# -----------------------------------------------------------
# Application
# -----------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# -----------------------------------------------------------
# Database - Local Development (SQLite)
# -----------------------------------------------------------
# Leave DATABASE_URL empty or set to file path for local SQLite
DATABASE_URL=file:./local.db

# -----------------------------------------------------------
# Database - Production (Turso/LibSQL)
# -----------------------------------------------------------
# Get these from https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# -----------------------------------------------------------
# Storage (Optional - for file uploads)
# -----------------------------------------------------------
# Cloudinary or any S3-compatible storage
STORAGE_URL=
STORAGE_KEY=

# -----------------------------------------------------------
# App Config
# -----------------------------------------------------------
APP_NAME=SmartSchool OS
APP_URL=http://localhost:3000
NODE_ENV=development
